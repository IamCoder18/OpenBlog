# pnpm configuration
# Settings here apply to every pnpm invocation in the project (CI, local
# dev, Docker build). Anything Docker-specific (store-dir for the
# BuildKit cache mount) is passed inline via --config.store-dir in the
# Dockerfile so it doesn't leak into other contexts where /pnpm is
# root-owned and unwritable (e.g. GitHub Actions runners).
shamefully-hoist=false
strict-peer-dependencies=false
auto-install-peers=true